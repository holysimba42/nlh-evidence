# Copy to .env and fill in. Practice (demo) = FREE data + free fills.
# Get these from your OANDA practice account -> Manage API Access.
OANDA_TOKEN=your-practice-token-here
OANDA_ACCOUNT_ID=101-004-XXXXXXX-001
OANDA_ENVIRONMENT=demo
ALLOW_LIVE=false

# Universe & timeframe
INSTRUMENTS=EUR_USD,GBP_USD,USD_JPY,AUD_USD,USD_CAD
SIGNAL_GRANULARITY=M5
HISTORY_BARS=3000

# Risk (defaults are deliberately conservative)
RISK_PER_TRADE_PCT=0.4
MAX_DAILY_LOSS_PCT=1.5
MAX_OPEN_TRADES=3
MAX_LEVERAGE=5.0
MAX_SPREAD_PIPS=2.0
COOLDOWN_AFTER_LOSS_MINUTES=30
MAX_CCY_EXPOSURE_X=2.0   # max |net exposure| per currency, in equity multiples

# Strategy
SIGNAL_THRESHOLD=0.55
ATR_SL_MULTIPLE=1.6
ATR_TP_MULTIPLE=2.4
SKIP_HOURS_UTC=21,22,23
SKIP_FRIDAY_AFTER_HOUR_UTC=19

# Costs (be pessimistic; demo spreads are often better than live)
DEFAULT_SPREAD_PIPS=1.0
SLIPPAGE_PIPS=0.3

# Runtime
DRY_RUN=true
DB_PATH=data/candles.db
TELEMETRY_PATH=data/telemetry.jsonl
ARTIFACTS_DIR=artifacts
DRYRUN_STATE_PATH=data/dryrun_state.json
DRYRUN_START_EQUITY=100000
LOG_LEVEL=INFO
